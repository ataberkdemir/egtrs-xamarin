                </Frame>
                
                
                <Label Text="Toplantı Oluştur" TextColor="#161e2d" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"></Label>

                <Grid RowDefinitions="Auto,Auto,Auto">
